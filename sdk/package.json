{
  "name": "@bazi/engagement-sdk",
  "version": "0.2.0",
  "description": "Privacy-first, provider-constrained engagement control SDK for therapeutic software.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test",
    "benchmark": "node benchmarks/engine.bench.js",
    "benchmark:device": "node benchmarks/device-profile.mjs --output evidence/device-profile.reference.json",
    "validate:model": "node scripts/validate-model.mjs",
    "keys:generate": "node scripts/generate-signing-keypair.mjs",
    "package:sign": "node scripts/sign-package.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "report": "python scripts/build-report.py",
    "check:a11y": "node scripts/a11y-check.mjs",
    "check": "node scripts/check-all.mjs && node --test && node scripts/a11y-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true
}
